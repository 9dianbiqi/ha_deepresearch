# Which search service to use, either 'duckduckgo', 'tavily', 'perplexity', Searxng
SEARCH_API='duckduckgo'

# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)

# 模型提供者
# LLM_PROVIDER=custom          # Options: ollama, lmstudio, custom 其中ollama和lmstudio都是用于本地大模型配置，custom是用于自定义大模型配置[用于api调用]
# 模型名称
LLM_MODEL_ID=glm-4.5-air

# API密钥
LLM_API_KEY=your-llm-api-key

# 服务地址
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# Optional whole-run deadline in seconds (0 < value <= 86400)
# RUN_TIMEOUT_SECONDS=900

# 服务器配置
HOST=127.0.0.1
PORT=8000

# Durable single-instance data root. Runs, artifacts, history, and memory stay here.
DATA_DIR=./data
RETENTION_DAYS=30
MAX_CONCURRENT_RUNS=1

# Required for production HTTP routes; /healthz and /readyz remain public.
APP_API_KEY=replace-with-a-long-random-value

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO
# Web Search API Keys (choose one or both)
# TAVILY_API_KEY=tvly-xxxxx      # Get your key at https://tavily.com
# PERPLEXITY_API_KEY=pplx-xxxxx  # Get your key at https://www.perplexity.ai
# For Searxng search, defaults to http://localhost:8888
# SEARXNG_URL=

# GitHub repository research (optional)
ENABLE_GITHUB_RESEARCH=True
# GITHUB_TOKEN=ghp_xxxxx
GITHUB_API_BASE_URL=https://api.github.com

# Opt-in paragraph Evidence path for explicit Web requests. Keep disabled until
# the deployment has validated its LLM verifier and artifact retention policy.
ENABLE_EVIDENCE_WEB=False
# Ordinary Web runs retain their legacy report; shadow mode records a
# non-blocking not-applicable outcome when no frozen Evidence bundle exists.
ENABLE_SUMMARY_QUALITY_SHADOW=True
SUMMARY_SEMANTIC_THRESHOLD=0.72
SUMMARY_FACTUAL_THRESHOLD=0.75
SUMMARY_CITATION_THRESHOLD=0.85
SUMMARY_OVERALL_THRESHOLD=0.78

# 本地模型配置(LMStudio/Ollama)
# LLM_PROVIDER=lmstudio          # Options: ollama, lmstudio
# LOCAL_LLM=qwen_qwq-32b         # Model name in LMStudio/Ollama
# LMSTUDIO_BASE_URL=http://localhost:1234/v1  # LMStudio OpenAI-compatible API URL
# OLLAMA_BASE_URL=http://localhost:11434 # the endpoint of the Ollama service, defaults to http://localhost:11434 if not set

MAX_WEB_RESEARCH_LOOPS=3
MAX_CONCURRENT_TASKS=4
FETCH_FULL_PAGE=True
ENABLE_SEARCH_CACHE=True
SEARCH_CACHE_TTL_SECONDS=86400
TASK_QUALITY_MODE=evidence
