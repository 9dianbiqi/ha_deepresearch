# Copy this file to .env.production, replace the placeholder, then run:
# docker compose --env-file .env.production up -d --build

APP_API_KEY=replace-with-a-long-random-value
# The production frontend calls /api and asks the operator for this key at first use.
VITE_API_BASE_URL=/api

FRONTEND_PORT=5174
CORS_ORIGINS=http://localhost:5174
MAX_CONCURRENT_RUNS=1
RETENTION_DAYS=30
MAX_WEB_RESEARCH_LOOPS=3
MAX_CONCURRENT_TASKS=4
FETCH_FULL_PAGE=true
ENABLE_NOTES=true
ENABLE_QUALITY_GATE=true
TASK_QUALITY_MODE=evidence
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_SECONDS=86400
ENABLE_GITHUB_RESEARCH=true
ENABLE_EVIDENCE_WEB=false
ENABLE_SUMMARY_QUALITY_SHADOW=true
SUMMARY_SEMANTIC_THRESHOLD=0.72
SUMMARY_FACTUAL_THRESHOLD=0.75
SUMMARY_CITATION_THRESHOLD=0.85
SUMMARY_OVERALL_THRESHOLD=0.78

LLM_PROVIDER=custom
LLM_MODEL_ID=replace-with-model-id
LLM_API_KEY=replace-with-llm-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MAX_TOKENS=4000
SEARCH_API=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=

# Optional authenticated GitHub API access.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
